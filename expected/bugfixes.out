/* NO ACTION is deferred: replacing coverage within a transaction is allowed. */
BEGIN;
DELETE FROM fk_parent WHERE id = 1;
INSERT INTO fk_parent VALUES (1, 10, 35), (1, 35, 90);
COMMIT;
SELECT id, s, e FROM fk_parent ORDER BY id, s;
 id | s  | e  
----+----+----
  1 | 10 | 35
  1 | 35 | 90
(2 rows)

