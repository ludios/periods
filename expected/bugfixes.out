 id | val | s  | e  
----+-----+----+----
  1 | a   | 10 | 20
  1 | b   | 20 | 30
  1 | a   | 30 | 40
(3 rows)

SELECT periods.drop_period('fp_tpk', 'p');
 drop_period 
